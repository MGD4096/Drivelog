<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sending the readings after a ride to Drivelog (CarPluginContract.ACTION_READING): Drivelog takes them only
         from apps that hold this permission, which only apps signed like Drivelog can. -->
    <uses-permission android:name="dev.drivelog.permission.CAR_PLUGIN" />

    <!-- The info screen shows whether Drivelog is installed, and the readings are sent to it. -->
    <!-- After a ride the plugin opens the motorcycle app (ScreenReaderService): the same package as in
         res/xml/screen_reader.xml. -->
    <queries>
        <package android:name="dev.drivelog" />
        <package android:name="com.bmw.ConnectedRide" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_directions"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- No launcher icon: Drivelog opens it (car page, "Open Drivelog Ride"); only apps signed like this one may. -->
        <activity
            android:name=".InfoActivity"
            android:exported="true"
            android:permission="dev.drivelog.permission.CAR_PLUGIN">
            <intent-filter>
                <action android:name="dev.drivelog.CAR_PLUGIN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- What Drivelog binds during a ride (plugin-api, CarPluginContract). -->
        <service
            android:name=".RidePluginService"
            android:exported="true"
            android:permission="dev.drivelog.permission.CAR_PLUGIN">
            <intent-filter>
                <action android:name="dev.drivelog.CAR_PLUGIN" />
            </intent-filter>
            <meta-data android:name="dev.drivelog.plugin.id" android:value="ride" />
            <meta-data android:name="dev.drivelog.plugin.label" android:value="Drivelog Ride" />
            <meta-data android:name="dev.drivelog.plugin.api" android:value="1" />
        </service>

        <!-- Reads the motorcycle app's screens (res/xml/screen_reader.xml). The user turns it on in the accessibility
             settings; only the system can bind it. -->
        <service
            android:name=".ScreenReaderService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/screen_reader" />
        </service>
    </application>
</manifest>
