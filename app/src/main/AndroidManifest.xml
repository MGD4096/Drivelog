<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The map tiles and the weather. (The car itself is reached by the car's plugin app, not by Drivelog.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Binding car plugin apps (plugin-api): the permission is defined there, "signature" level, so only plugins
         signed with Drivelog's key can be used; <queries> lets Drivelog see the installed plugins (Android 11+). -->
    <uses-permission android:name="dev.drivelog.permission.CAR_PLUGIN" />
    <queries>
        <intent>
            <action android:name="dev.drivelog.CAR_PLUGIN" />
        </intent>
        <intent>
            <action android:name="dev.drivelog.CAR_PLUGIN_SETTINGS" />
        </intent>
    </queries>

    <!-- Reading the list of paired devices, and to be told when the car connects (API 30 and older). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- The GPS track. Background location lets the trip service read GPS when it was started by the car's Bluetooth. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- So that the daily reminder check is scheduled again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app ask for "unrestricted" battery use, which is what allows it to start a trip from the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".car.CarActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <activity android:name=".car.CarTripsActivity" android:exported="false" />

        <activity
            android:name=".car.PhotoGalleryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />


        <activity android:name=".map.MapActivity" android:exported="false" />
        <activity android:name=".trips.StatsActivity" android:exported="false" />

        <!-- Which car a home-screen widget shows: the launcher opens it when the widget is placed. -->
        <activity
            android:name=".WidgetCarActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/WidgetPicker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Which vehicles the several-vehicles widget shows: opened when that widget is placed. -->
        <activity
            android:name=".WidgetCarsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/WidgetPicker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The home-screen widget with several vehicles (CarsWidget). Like CarWidget: never rename or move it. -->
        <receiver android:name=".CarsWidget" android:exported="true" android:label="@string/widget_cars_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_cars_info" />
        </receiver>

        <!-- The Business / Private buttons of the "Trip finished" notification. -->
        <receiver android:name=".recording.TripKindReceiver" android:exported="false" />

        <!-- The home-screen widget. Exported because the launcher sends it APPWIDGET_UPDATE (a system broadcast). -->
        <receiver android:name=".CarWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_car_info" />
        </receiver>

        <service
            android:name=".reminders.ReminderJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".recording.TripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ACL_CONNECTED is a protected broadcast: only the system can send it, so exported is safe here. -->
        <receiver
            android:name=".recording.CarBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Values a plugin reads after the trip (CarPluginContract.ACTION_READING). Exported, but only apps that hold
             the plugin permission (signature: signed like Drivelog) can send to it. -->
        <receiver
            android:name=".plugin.PluginReadingReceiver"
            android:exported="true"
            android:permission="dev.drivelog.permission.CAR_PLUGIN">
            <intent-filter>
                <action android:name="dev.drivelog.CAR_READING" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".trips.ExportProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
