<?xml version="1.0" encoding="utf-8"?>
<!-- The last trip (LastTripWidget). Redrawn by the app after every trip. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:initialLayout="@layout/widget_last_trip"
    android:previewLayout="@layout/widget_last_trip"
    android:description="@string/widget_last_trip_description"
    android:widgetCategory="home_screen" />
