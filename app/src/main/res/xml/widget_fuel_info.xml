<?xml version="1.0" encoding="utf-8"?>
<!-- Fuel and consumption of one vehicle (FuelWidget). Redrawn by the app after trips and refuellings. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="140dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:configure="dev.drivelog.WidgetCarActivity"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/widget_fuel"
    android:previewLayout="@layout/widget_fuel"
    android:description="@string/widget_fuel_description"
    android:widgetCategory="home_screen" />
