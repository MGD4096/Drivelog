<?xml version="1.0" encoding="utf-8"?>
<!-- This month on all vehicles (MonthWidget). Redrawn by the app after trips, refuellings and service entries. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="140dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="10800000"
    android:initialLayout="@layout/widget_month"
    android:previewLayout="@layout/widget_month"
    android:description="@string/widget_month_description"
    android:widgetCategory="home_screen" />
