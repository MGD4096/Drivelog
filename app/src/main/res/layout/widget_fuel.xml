<?xml version="1.0" encoding="utf-8"?>
<!-- Fuel and consumption of one vehicle (FuelWidget): its average consumption over the latest full tanks, what is in the tank, the last refuelling, and the fuel spent this year. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fuel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/fuel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_title"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/fuel_average"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/fuel_average_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/fuel_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/fuel_tank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/fuel_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/fuel_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
</LinearLayout>
