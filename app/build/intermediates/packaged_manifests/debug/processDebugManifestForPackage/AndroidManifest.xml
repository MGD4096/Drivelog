<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.idrivetrips"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Needed to open the local server socket on port 8765 (nothing is ever sent to the internet). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading the list of paired devices, and to be told when the car connects (API 30 and older). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- The GPS track. Background location lets the trip service read GPS when it was started by the car's Bluetooth. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- So that the daily reminder check is scheduled again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app ask for "unrestricted" battery use, which is what allows it to start a trip from the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name="dev.idrivetrips.App"
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:testOnly="true"
        android:theme="@style/AppTheme" >
        <activity
            android:name="dev.idrivetrips.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="dev.idrivetrips.CarActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name="dev.idrivetrips.CarTripsActivity"
            android:exported="false" />
        <activity
            android:name="dev.idrivetrips.PhotoGalleryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name="dev.idrivetrips.MapActivity"
            android:exported="false" />

        <service
            android:name="dev.idrivetrips.ReminderJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name="dev.idrivetrips.TripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ACL_CONNECTED is a protected broadcast: only the system can send it, so exported is safe here. -->
        <receiver
            android:name="dev.idrivetrips.CarBluetoothReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="dev.idrivetrips.ExportProvider"
            android:authorities="dev.idrivetrips.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>