# Line endings that must not depend on core.autocrlf: shell scripts, the Makefile and Python run on Linux, QNX or
# in Docker (a CR breaks them there); batch files run in cmd.
*.sh        text eol=lf
*.py        text eol=lf
Makefile    text eol=lf
Dockerfile* text eol=lf
*.bat       text eol=crlf
*.ps1       text eol=crlf

*.zip binary
*.png binary
*.tar binary
*.so  binary
